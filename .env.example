# MetGate — endpoint et token applicatif
# Copier ce fichier en .env et remplir les valeurs. Ne JAMAIS committer .env.
METGATE_BASE_URL=https://metgate-int.meteo.fr
METGATE_TOKEN=

# Serveur portail
PORT=8080

# Cache TTL (secondes) sur les réponses MetGate. 0 désactive.
METGATE_CACHE_TTL_SECONDS=60

# OpenSky Network (suivi ADS-B). Compte gratuit sur opensky-network.org.
# Auth OAuth2 (méthode actuelle, depuis fin 2024) — generer un client API
# dans Personal Account Settings → Download credentials → JSON {clientId, clientSecret}
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Auth Basic (legacy, encore acceptée pour les anciens comptes)
OPENSKY_USER=
OPENSKY_PASS=

# EUMETSAT Data Store / EUMETView (foudre MTG-LI, sommets nuageux MTG-FCI CTTH,
# tuiles satellite FCI IR / RGB Convection). Compte gratuit sur eoportal.eumetsat.int
# → My Profile → API Key → générer un couple consumer_key / consumer_secret.
# Sans ces clés, /api/lightning, /api/cloudtop et /api/satellite/tile renvoient 503.
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=

# Proxy sortant (optionnel) — tous les flux extérieurs du backend (MetGate,
# OpenSky, adsb.fi, EUMETSAT, EUMETView) passent par un transport HTTP commun.
# OUTBOUND_PROXY_URL : proxy d'entreprise explicite (http://host:port,
#   https://… ou socks5://…), prioritaire sur HTTP_PROXY/HTTPS_PROXY.
# Les variables standard HTTP_PROXY / HTTPS_PROXY / NO_PROXY sont aussi
# honorées (convention Unix), y compris depuis ce fichier.
OUTBOUND_PROXY_URL=
# Hôtes à joindre en direct (exact, suffixe « .meteo.fr », ou « * »)
NO_PROXY=
# Certificat(s) CA PEM supplémentaires (proxy TLS interceptant)
OUTBOUND_CA_FILE=
# OUTBOUND_TLS_INSECURE=1 désactive la vérification TLS sortante (dernier recours)
OUTBOUND_TLS_INSECURE=

# URLs des services extérieurs (optionnel) — défauts publics codés dans le
# binaire ; ne surcharger que pour pointer un miroir interne ou un bouchon
# de test. Un / final éventuel est toléré.
OPENSKY_BASE_URL=
OPENSKY_AUTH_URL=
ADSBFI_BASE_URL=
EUMETSAT_API_BASE_URL=
EUMETVIEW_WMS_URL=
